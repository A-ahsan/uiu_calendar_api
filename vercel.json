{
  "version": 2,
  "buildCommand": "find . -name package.json && [ -d uiu-academic-calendar/frontend ] && cd uiu-academic-calendar/frontend && npm ci --legacy-peer-deps && npm run build || echo 'Missing directory - check structure'",
  "outputDirectory": "uiu-academic-calendar/frontend/dist",
  "installCommand": "echo 'Cache busted v6 - shortened command'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
