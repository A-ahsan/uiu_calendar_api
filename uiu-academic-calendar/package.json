{
  "name": "uiu-academic-calendar",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "install-all": "npm --prefix backend install && npm --prefix frontend install",
    "start:backend": "node backend/index.js",
    "start:frontend": "npm --prefix frontend run dev",
    "start": "concurrently \"npm: start:backend\" \"npm: start:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
